includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - tests/

    level: max

    # Functions only the static micro runtime of the native binary defines.
    scanFiles:
        - stubs/micro.stub
